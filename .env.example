# ======================
# Server
# ======================
PORT=5000
NODE_ENV=development

# ======================
# Database
# ======================
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@todo-dev-cluster.1eldpej.mongodb.net/mind_signal_dev?retryWrites=true&w=majority

# ADR-011 MongoDB SRV DNS resolver fallback (Phase 18.1 D-0 hotspot 함정 우회용)
# Node c-ares가 OS Wi-Fi 어댑터 DNS 변경을 후속 감지 안 함. 5/26 D-0 시연 환경 같은
# 학교 Wi-Fi에서 OS DNS를 8.8.8.8로 변경해도 mongoose SRV 조회 ECONNREFUSED 발생함.
# 본 env 활성화 시 mongoose.connect 직전에 dns.setServers 호출함.
# 비어 있으면 OS 기본 DNS 경로 유지 (production 권장). production 사용 시 사내 DNS
# 차단망 가정 안 됨 확인 의무 (8.8.8.8 outbound 차단 시 BE 기동 실패).
# 예: MONGODB_SRV_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_SRV_DNS_SERVERS=

# ======================
# Authentication (JWT)
# ======================
JWT_SECRET_KEY=your_jwt_secret_key_here
# 토큰 수명 제어용
JWT_EXPIRES_IN=1d    

# ======================
# CORS 프론트 접근 제어용
# ======================
CORS_ORIGIN=http://localhost:3000

# ======================
# External APIs
# ======================
GOOGLE_API_KEY=your_google_api_key_here

# ======================
# File Upload 파일 저장 위치 제어용
# ======================
UPLOAD_DIR=uploads

# ======================
# Redis (Upstash 클라우드 사용 시 REDIS_URL만 설정, 로컬 Docker 사용 시 생략)
# ======================
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ======================
# mind-signal-data-engine 프로젝트 저장 위치 제어용
# ======================
DATA_ENGINE_PATH=../mind-signal-data-engine
PUBLIC_BASE_URL=http://localhost:5000

#======================
# mind-signal-data-engine 데이터 호출 베이스 url
# ======================
DATA_ENGINE_URL=<mind-signal-data-engine 데이터 호출 베이스 url>

# ======================
# Python EEG 엔진 바이너리 경로 (mind-signal conda 환경)
# ======================
DATA_ENGINE_PYTHON=C:\Users\<YOUR_USERNAME>\.conda\envs\mind-signal\python.exe

# ======================
# 소셜 로그인 — Google (Google Cloud Console > OAuth 2.0 클라이언트 ID)
# ======================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ======================
# 소셜 로그인 — Kakao (Kakao Developers > 내 애플리케이션 > 앱 키)
# ======================
KAKAO_CLIENT_ID=your_kakao_rest_api_key_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here
KAKAO_REDIRECT_URI=http://localhost:3000/auth/callback

# ======================
# Gmail Configuration (for /chat/ask)
# ======================
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# ======================
# Daum Configuration (for /chat/ask)
# ======================
DAUM_USER=your-email@daum.net
DAUM_PASS=your-app-password

# ======================
# 문의 담당자 이메일
# ======================
ASK_USER=mks004@neurosignal.kr

# ======================
# Phase 16 DUAL_2PC — optional (defaults: 200 / 60000)
# ======================
DUAL_2PC_TIMESTAMP_TOLERANCE_MS=200
DUAL_2PC_REGISTRATION_TIMEOUT_MS=60000

# ======================
# K phase 강제 페어링 admin allowlist (콤마 구분, 자동 lowercase normalize)
# ======================
ADMIN_EMAILS=
